# Copy this file to .env and fill values locally.
# Do not paste secrets into the browser dashboard or chat.

PORT=8787
META_GRAPH_VERSION=v23.0

META_APP_ID=1365265765442781
META_APP_SECRET=
META_ACCESS_TOKEN=

# Facebook Page from your linked Page URL:
FACEBOOK_PAGE_ID=61590381973296
FACEBOOK_PAGE_NAME=Maja's Coffee Jazz Zone

# Fill after the readiness checker discovers/confirms it:
IG_USER_ID=
IG_HANDLE=@majascoffeejazzzone

PUBLISHING_MODE=manual
REQUIRE_APPROVAL=true

# Cloudflare R2 public Reel hosting:
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# YouTube publishing and performance sync:
# OAuth should grant youtube.upload and youtube.readonly.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Optional: test uploads default to the privacy selected in the app.
# Use private first while testing.

# Stock atmosphere video sourcing:
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional Song Factory downloader launcher:
# Example path: C:\Program Files\Your Suno Downloader\downloader.exe
# Args are passed to the downloader when you click "Download with app".
# Use {url} wherever the Suno playlist URL should go.
SUNO_DOWNLOADER_PATH=
SUNO_DOWNLOADER_ARGS="{url}"
