<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReleasePilot</AssemblyName>
    <RootNamespace>ReleasePilot.Launcher</RootNamespace>
    <ApplicationIcon>..\..\outputs\jazz-content-scheduler\assets\releasepilot.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <CompanyName>ReleasePilot</CompanyName>
    <Product>ReleasePilot</Product>
    <Description>ReleasePilot local app launcher</Description>
  </PropertyGroup>
</Project>
